/* =========================
   CSS RESET
========================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: "Open Sans", sans-serif;
    color: #222;
    background: white;
    line-height: 1.6;
}

img {
    max-width: 100%;
    display: block;
}

a {
    color: inherit;
}

h1,
h2,
h3,
p {
    margin-top: 0;
}


/* =========================
   GENERAL
========================= */

.container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
}

section {
    padding: 3rem 0;
}

h1 {
    font-size: 2.2rem;
}

h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
}

h3 {
    font-size: 1.5rem;
}


/* =========================
   HEADER
========================= */

.site-header {
    background: #222;
    color: white;
}

.header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0;
}

.logo img {
    width: 100px;
    margin-bottom: 1rem;
}

.navigation {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: center;
}

.navigation li {
    margin: 0.5rem 0;
}

.navigation a {
    text-decoration: none;
    color: white;
    font-weight: 600;
}

.navigation a:hover {
    color: #c78c06;
}

.search-form {
    margin-top: 1rem;
    display: flex;
}

.search-form label {
    position: absolute;
    left: -9999px;
}

.search-form input {
    padding: 0.5rem;
    border: none;
}

.search-form button {
    background: #c78c06;
    border: none;
    padding: 0.5rem;
}


/* =========================
   HERO
========================= */

.hero {
    background-image:
        linear-gradient(rgba(34, 34, 34, 0.65), rgba(34, 34, 34, 0.65)),
        url("../images/main-banner.jpg");

    background-size: cover;
    background-position: center;
    min-height: 500px;

    display: flex;
    align-items: center;
}

.hero-content {
    display: flex;
    align-items: center;
}

.hero-text {
    background: rgba(34, 34, 34, 0.85);
    color: white;
    padding: 2rem;
    max-width: 700px;
}

.hero-text h1 {
    margin-bottom: 1rem;
}

.button {
    display: inline-block;
    background: #c78c06;
    color: #222;
    text-decoration: none;
    padding: 0.8rem 1.2rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
}

.button:hover {
    background: #ffe6ac;
}


/* =========================
   ABOUT
========================= */

.about {
    background: white;
}

.about-grid {
    display: grid;
    gap: 2rem;
}

.about-image img {
    width: 100%;
}

.about-text h2 {
    color: #222;
}


/* =========================
   SERVICES
========================= */

.services {
    background: #ffe6ac;
}

.service-grid {
    display: grid;
    gap: 1.5rem;
}

.service-card {
    background: white;
}

.service-card img {
    width: 100%;
}

.service-content {
    padding: 1.5rem;
}

.dark-button {
    display: block;
    background: #222;
    color: white;
    text-decoration: none;
    padding: 1rem;
    text-align: center;
    font-weight: 600;
}

.dark-button:hover {
    background: #c78c06;
    color: #222;
}


/* =========================
   TEAM
========================= */

.team {
    background: white;
}

.team-grid {
    display: grid;
    gap: 2rem;
}

.team-member {
    display: flex;
    flex-direction: column;
    background: #ffe6ac;
}

.team-member img {
    width: 100%;
}

.team-member div {
    padding: 1.5rem;
}

.team-member h3 {
    margin-bottom: 0.2rem;
}


/* =========================
   CONTACT
========================= */

.contact {
    background: #ffe6ac;
}

.contact-grid {
    display: grid;
    gap: 2rem;
}

.contact-form,
.location {
    background: white;
    padding: 1.5rem;
}

.contact-form form {
    display: flex;
    flex-direction: column;
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    padding: 0.7rem;
    margin-bottom: 1rem;
    border: 1px solid #222;
}

.contact-form textarea {
    min-height: 150px;
    resize: vertical;
}

.map {
    height: 250px;
    background: #ddd;
    display: flex;
    align-items: center;
    justify-content: center;
}


/* =========================
   FOOTER
========================= */

footer {
    background: #222;
    color: white;
    padding: 2rem 0;
}

.footer-content {
    text-align: center;
}

.footer-content a {
    color: #ffe6ac;
}


/* =========================
   TABLET / DESKTOP
   760px AND ABOVE
========================= */

@media screen and (min-width: 760px) {

    section {
        padding: 4rem 0;
    }

    h1 {
        font-size: 3.5rem;
    }

    h2 {
        font-size: 2.5rem;
    }


    /* Header becomes horizontal */
    .header-content {
        flex-direction: row;
        justify-content: space-between;
    }

    .logo img {
        margin-bottom: 0;
    }

    .navigation {
        display: flex;
        gap: 1.5rem;
    }

    .navigation li {
        margin: 0;
    }

    .search-form {
        margin-top: 0;
    }


    /* About uses CSS Grid */
    .about-grid {
        grid-template-columns: 1fr 1fr;
        align-items: center;
    }


    /* Services use CSS Grid */
    .service-grid {
        grid-template-columns: repeat(2, 1fr);
    }


    /* Team uses CSS Grid */
    .team-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .team-member {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }


    /* Contact uses CSS Grid */
    .contact-grid {
        grid-template-columns: 1fr 1fr;
    }


    .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
}


/* =========================
   LARGE DESKTOP
========================= */

@media screen and (min-width: 1000px) {

    .service-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero {
        min-height: 600px;
    }

    .hero-text {
        padding: 3rem;
    }
}