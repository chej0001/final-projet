/* =========================================
   CSS RESET
   ========================================= */

*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Open Sans", Arial, sans-serif;
    color: #222;
    background-color: white;
    line-height: 1.5;
}

img {
    display: block;
    max-width: 100%;
}

a {
    color: inherit;
}

button,
input,
textarea {
    font: inherit;
}


/* =========================================
   GENERAL STYLES
   ========================================= */

.container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
}

h1,
h2,
h3 {
    line-height: 1.2;
}

h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
}

.button {
    display: inline-block;
    background-color: #222;
    color: white;
    text-decoration: none;
    padding: 0.75rem 1rem;
    border: 0;
    margin-top: 0.75rem;
    cursor: pointer;
}

.button span {
    margin-left: 0.5rem;
}

.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}


/* =========================================
   HEADER
   ========================================= */

.site-header {
    background-color: #ffe6ac;
}

.header-container {
    display: flex;
    flex-direction: column;
    align-items: stretch;
}

.logo {
    display: block;
    background-color: #c78c06;
    padding: 0.75rem;
}

.logo img {
    width: 120px;
    height: auto;
    margin: 0 auto;
}

.main-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    text-align: center;
}

.main-nav a {
    display: block;
    text-decoration: none;
    padding: 0.65rem;
    color: #222;
}

.main-nav a:hover,
.main-nav a:focus {
    background-color: #c78c06;
    color: white;
}

.search-form {
    display: flex;
    margin: 0.75rem 0 1rem;
}

.search-form input {
    flex: 1;
    min-width: 0;
    padding: 0.65rem;
    border: 1px solid #222;
}

.search-form button {
    width: 45px;
    border: 1px solid #222;
    background-color: #ffe6ac;
    color: #222;
    cursor: pointer;
}


/* =========================================
   HERO
   ========================================= */

.hero {
    min-height: 480px;
    display: flex;
    align-items: center;
    background-image:
        linear-gradient(rgba(34, 34, 34, 0.45), rgba(34, 34, 34, 0.45)),
        url("../images/hero.jpg");
    background-size: cover;
    background-position: center;
    color: white;
}

.hero-content {
    padding-top: 3rem;
    padding-bottom: 3rem;
}

.hero h1 {
    font-size: 2.4rem;
    margin-bottom: 1rem;
}

.hero p {
    max-width: 650px;
    margin-bottom: 1rem;
}

.hero .button {
    background-color: #c78c06;
}


/* =========================================
   ABOUT US
   ========================================= */

.about {
    background-color: #ffe6ac;
    padding: 2rem 0;
}

.about-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.about-image img {
    width: 100%;
}

.about-text p {
    margin-bottom: 1rem;
}


/* =========================================
   SERVICES
   ========================================= */

.services {
    padding: 2rem 0;
    background-color: white;
}

.service-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
}

.service-card {
    background-color: #ffe6ac;
}

.service-card img {
    width: 100%;
}

.service-content {
    padding: 1rem;
}

.service-content h3 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
}

.service-content p {
    margin-bottom: 0.5rem;
}

.service-content .button {
    background-color: #222;
}


/* =========================================
   VISION
   ========================================= */

.vision {
    padding: 2rem 0;
    background-color: #ffe6ac;
}

.vision-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.vision-image img {
    width: 100%;
}

.vision-text p {
    margin-bottom: 0.5rem;
}


/* =========================================
   TEAM
   ========================================= */

.team {
    padding: 2rem 0;
    background-color: white;
}

.team-grid {
    display: grid;
    grid-template-columns: 1fr;
}

.team-member {
    background-color: #ffe6ac;
}

.team-member img {
    width: 100%;
}

.team-info {
    padding: 1rem;
}

.team-info h3 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
}

.job-title {
    font-weight: bold;
    margin-bottom: 0.75rem;
}


/* =========================================
   CONTACT
   ========================================= */

.contact {
    padding: 2rem 0;
    background-color: white;
}

.contact-form {
    margin-bottom: 2rem;
}

.contact-form h3,
.business-info h3 {
    margin-bottom: 0.75rem;
}

.form-group {
    margin-bottom: 0.75rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.25rem;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 0.6rem;
    border: 1px solid #999;
}

.form-group textarea {
    resize: vertical;
}

.contact-form .button {
    background-color: #c78c06;
}

.business-info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}


/* =========================================
   HOURS TABLE
   ========================================= */

.hours table {
    width: 100%;
    border-collapse: collapse;
}

.hours th,
.hours td {
    border: 1px solid #999;
    padding: 0.6rem;
    text-align: left;
}

.hours th {
    background-color: #ffe6ac;
}


/* =========================================
   LOCATION
   ========================================= */

.map {
    width: 100%;
    height: 300px;
}

.map iframe {
    width: 100%;
    height: 100%;
    border: 0;
}


/* =========================================
   FOOTER
   ========================================= */

.site-footer {
    background-color: #222;
    color: white;
    text-align: center;
    padding: 1.5rem 0;
}


/* =========================================
   DESKTOP / TABLET
   Minimum width: 760px
   ========================================= */

@media (min-width: 760px) {

    .container {
        padding-left: 2rem;
        padding-right: 2rem;
    }

    /* Header becomes horizontal */
    .header-container {
        flex-direction: row;
        align-items: center;
        gap: 1rem;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }

    .logo {
        padding: 0.5rem;
        flex-shrink: 0;
    }

    .logo img {
        width: 110px;
    }

    .main-nav {
        flex: 1;
    }

    .main-nav ul {
        flex-direction: row;
        justify-content: center;
    }

    .main-nav a {
        padding: 0.6rem 0.75rem;
    }

    .search-form {
        width: 230px;
        margin: 0;
    }


    /* Hero */
    .hero {
        min-height: 500px;
    }

    .hero h1 {
        font-size: 3.5rem;
        max-width: 700px;
    }

    .hero-content {
        padding-top: 5rem;
        padding-bottom: 5rem;
    }


    /* About */
    .about-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: center;
    }


    /* Services */
    .service-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .service-card {
        display: flex;
        flex-direction: column;
    }

    .service-content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .service-content .button {
        margin-top: auto;
        align-self: flex-start;
    }


    /* Vision */
    .vision-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: center;
    }


    /* Team */
    .team-grid {
        grid-template-columns: 1fr 1fr;
    }

    .team-member {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .team-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }


    /* Contact */
    .contact .container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 2rem;
    }

    .contact h2 {
        grid-column: 1 / -1;
    }

    .contact-form {
        margin-bottom: 0;
    }

    .business-info {
        gap: 2rem;
    }

}


/* =========================================
   LARGE DESKTOP
   ========================================= */

@media (min-width: 1000px) {

    .header-container {
        padding-top: 1.25rem;
        padding-bottom: 1.25rem;
    }

    .main-nav a {
        padding-left: 1rem;
        padding-right: 1rem;
    }

    .hero {
        min-height: 560px;
    }

    .hero h1 {
        font-size: 4rem;
    }

    .service-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .team-member img {
        height: 100%;
        object-fit: cover;
    }

}