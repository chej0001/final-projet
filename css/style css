* =========================================================
   THREE STAR MEDIA
   Final Project CSS
   Mobile-first responsive design
   ========================================================= */


/* =========================================================
   CSS RESET
   ========================================================= */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body,
h1,
h2,
h3,
p,
figure {
    margin: 0;
}

img {
    display: block;
    max-width: 100%;
}

button,
input,
textarea {
    font: inherit;
}

a {
    color: inherit;
    text-decoration: none;
}


/* =========================================================
   ROOT VARIABLES
   Required project colours
   ========================================================= */

:root {
    --gold: #c78c06;
    --light-gold: #ffe6ac;
    --dark: #222;
    --white: #fff;
}


/* =========================================================
   GENERAL STYLES
   ========================================================= */

body {
    background-color: var(--white);
    color: var(--dark);
    font-family: "Open Sans", sans-serif;
    font-size: 1rem;
    line-height: 1.6;
}

.container {
    width: min(100% - 2rem, 1200px);
    margin: 0 auto;
}

.section {
    padding: 2rem 0;
}

h1,
h2,
h3 {
    line-height: 1.2;
}

h1 {
    font-size: 2rem;
}

h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
}

h3 {
    font-size: 1.25rem;
}

p {
    margin-bottom: 1rem;
}


/* =========================================================
   ACCESSIBILITY
   ========================================================= */

.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}


/* =========================================================
   HEADER
   ========================================================= */

.site-header {
    background-color: var(--gold);
    color: var(--dark);
}

.header-container {
    display: flex;
    flex-direction: column;
    align-items: stretch;
}

.logo {
    display: block;
    padding: 1rem 0;
}

.logo img {
    width: 100px;
    margin: 0 auto;
}

.main-nav {
    display: flex;
    flex-direction: column;
    text-align: center;
}

.main-nav a {
    padding: 0.6rem;
    font-weight: 700;
}

.main-nav a:hover,
.main-nav a:focus {
    background-color: var(--light-gold);
}

.search-form {
    display: flex;
    margin: 0.75rem 0 1rem;
}

.search-form input {
    width: 100%;
    min-width: 0;
    padding: 0.5rem;
    border: 1px solid var(--dark);
    background-color: var(--white);
}

.search-form button {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--dark);
    background-color: var(--dark);
    color: var(--white);
    cursor: pointer;
}


/* =========================================================
   HERO
   ========================================================= */

.hero {
    min-height: 430px;
    display: flex;
    align-items: center;
    color: var(--white);

    background-image:
        linear-gradient(
            rgba(34, 34, 34, 0.55),
            rgba(34, 34, 34, 0.55)
        ),
        url("../images/main-banner.jpg");

    background-size: cover;
    background-position: center;
}

.hero-container {
    display: flex;
    align-items: center;
}

.hero-content {
    max-width: 650px;
}

.hero h1 {
    margin-bottom: 1rem;
}

.hero p {
    margin-bottom: 1.5rem;
}


/* =========================================================
   BUTTONS
   ========================================================= */

.button {
    display: inline-block;
    padding: 0.7rem 1rem;
    border: 2px solid var(--dark);
    background-color: var(--dark);
    color: var(--white);
    font-weight: 700;
}

.button:hover,
.button:focus {
    border-color: var(--gold);
    background-color: var(--gold);
    color: var(--dark);
}


/* =========================================================
   ABOUT
   CSS GRID
   ========================================================= */

.about {
    background-color: var(--white);
}

.about-grid {
    display: grid;
    gap: 1rem;
}

.about-image img {
    width: 100%;
}

.about-content {
    font-size: 0.95rem;
}


/* =========================================================
   SERVICES
   CSS GRID
   ========================================================= */

.services {
    background-color: var(--light-gold);
}

.services-grid {
    display: grid;
    gap: 1.25rem;
}

.service-card {
    background-color: var(--white);
}

.service-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
}

.service-content {
    padding: 1rem;
}

.service-content h3 {
    margin-bottom: 0.75rem;
}

.service-content p {
    font-size: 0.9rem;
}


/* =========================================================
   TEAM
   ========================================================= */

.team {
    background-color: var(--white);
}

.team-grid {
    display: grid;
    gap: 1.5rem;
}

.team-member {
    background-color: var(--light-gold);
}

.team-member img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
}

.team-content {
    padding: 1rem;
}

.team-content h3 {
    margin-bottom: 0.25rem;
}

.team-role {
    font-weight: 700;
}


/* =========================================================
   CONTACT
   ========================================================= */

.contact {
    background-color: var(--white);
}

.contact-grid {
    display: grid;
    gap: 2rem;
}

.contact-form h3,
.hours h3,
.location h3 {
    margin-bottom: 0.75rem;
}

.form-group {
    margin-bottom: 1rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.25rem;
    font-weight: 700;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 0.6rem;
    border: 1px solid var(--dark);
    background-color: var(--white);
}

.form-group textarea {
    resize: vertical;
}

.form-group input:focus,
.form-group textarea:focus {
    outline: 2px solid var(--gold);
    border-color: var(--gold);
}


/* =========================================================
   HOURS TABLE
   ========================================================= */

.hours table {
    width: 100%;
    border-collapse: collapse;
}

.hours th,
.hours td {
    padding: 0.65rem;
    border: 1px solid var(--dark);
    text-align: left;
}

.hours th {
    background-color: var(--light-gold);
}


/* =========================================================
   MAP
   ========================================================= */

.map {
    width: 100%;
    min-height: 300px;
}

.map iframe {
    width: 100%;
    height: 300px;
    border: 0;
}


/* =========================================================
   FOOTER
   FLEXBOX
   ========================================================= */

.footer {
    padding: 1.5rem 0;
    background-color: var(--dark);
    color: var(--white);
}

.footer-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.footer p {
    margin: 0;
}

.social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
}

.social-links a {
    text-decoration: underline;
}

.social-links a:hover,
.social-links a:focus {
    color: var(--light-gold);
}


/* =========================================================
   MEDIA QUERY
   760px AND ABOVE
   ========================================================= */

@media screen and (min-width: 760px) {

    .container {
        width: min(100% - 3rem, 1200px);
    }

    .section {
        padding: 3rem 0;
    }


    /* Header */
    .header-container {
        display: grid;
        grid-template-columns: 150px 1fr;
        align-items: center;
        gap: 1rem;
    }

    .logo {
        padding: 1rem 0;
    }

    .logo img {
        width: 100px;
        margin: 0;
    }

    .main-nav {
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: 0.25rem;
    }

    .main-nav a {
        padding: 0.5rem 0.65rem;
    }

    .search-form {
        grid-column: 1 / -1;
        margin: 0 0 1rem;
    }


    /* Hero */
    .hero {
        min-height: 500px;
    }

    .hero h1 {
        font-size: 3rem;
    }


    /* About */
    .about-grid {
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 2rem;
    }


    /* Services */
    .services-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }


    /* Team */
    .team-grid {
        grid-template-columns: repeat(2, 1fr);
    }


    /* Contact */
    .contact-grid {
        grid-template-columns: 1fr 1fr;
        align-items: start;
    }

    .location {
        grid-column: 1 / -1;
    }


    /* Footer Flexbox */
    .footer-container {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

}


/* =========================================================
   LARGE SCREENS
   ========================================================= */

@media screen and (min-width: 1000px) {

    .header-container {
        grid-template-columns: 130px 1fr 250px;
    }

    .search-form {
        grid-column: auto;
        margin: 0;
    }

    .main-nav {
        justify-content: center;
    }

    .hero {
        min-height: 550px;
    }

    .services-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .contact-grid {
        grid-template-columns: 1.2fr 0.8fr 1fr;
    }

    .location {
        grid-column: auto;
    }

}