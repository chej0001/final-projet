 /* ==============================
   CSS RESET
   ============================== */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Open Sans", sans-serif;
    color: #222;
    background-color: white;
    line-height: 1.6;
}

img {
    display: block;
    width: 100%;
    height: auto;
}

a {
    color: inherit;
    text-decoration: none;
}

ul {
    list-style: none;
}

button,
input,
textarea {
    font: inherit;
}


/* ==============================
   GENERAL CONTAINER
   ============================== */

.container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
}


/* ==============================
   HEADER / NAVIGATION
   ============================== */

header {
    background-color: #222;
    color: white;
}

nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0;
    gap: 1rem;
}

.logo {
    background-color: #c78c06;
    color: white;
    padding: 0.7rem 1rem;
    font-size: 1.5rem;
    font-weight: 700;
}

nav ul {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-align: center;
}

nav li {
    border-bottom: 1px solid #555;
}

nav a {
    display: block;
    padding: 0.8rem;
    color: white;
    transition: background-color 0.3s ease;
}

nav a:hover,
nav a.active {
    background-color: #c78c06;
    color: white;
}


/* ==============================
   MAIN HEADINGS
   ============================== */

h1,
h2,
h3 {
    line-height: 1.2;
}

h1 {
    font-size: 2.2rem;
}

h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
}

h3 {
    font-size: 1.3rem;
    margin-bottom: 0.7rem;
}


/* ==============================
   BUTTONS
   ============================== */

.button,
.btn {
    display: inline-block;
    background-color: #c78c06;
    color: #222;
    padding: 0.8rem 1.2rem;
    margin-top: 1rem;
    border: none;
    font-weight: 700;
    cursor: pointer;
}

.button:hover,
.btn:hover {
    background-color: #ffe6ac;
}


/* ==============================
   HOME / HERO SECTION
   ============================== */

.hero {
    background-color: #222;
    color: white;
    padding: 2rem 0;
}

.hero .container {
    display: flex;
    flex-direction: column;
}

.hero-image {
    width: 100%;
}

.hero-content {
    background-color: rgba(34, 34, 34, 0.9);
    padding: 1.5rem;
}

.hero-content h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.hero-content p {
    margin-bottom: 1rem;
}


/* ==============================
   ABOUT SECTION
   ============================== */

.about {
    background-color: #ffe6ac;
    padding: 2rem 0;
}

.about .container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.about-image {
    width: 100%;
}

.about-content {
    padding: 1rem;
}

.about-content h2 {
    font-size: 2rem;
}


/* ==============================
   SERVICES PAGE
   ============================== */

.services {
    padding: 2rem 0;
}

.services-title {
    margin-bottom: 1.5rem;
}

.services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
}

.service-card {
    background-color: #ffe6ac;
}

.service-card img {
    width: 100%;
}

.service-content {
    padding: 1.2rem;
}

.service-content p {
    margin-bottom: 1rem;
}


/* ==============================
   FEATURED SERVICES
   ============================== */

.featured-services {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.featured-card {
    background-color: #ffe6ac;
}

.featured-card img {
    width: 100%;
}

.featured-content {
    padding: 1.2rem;
}


/* ==============================
   TEAM PAGE
   ============================== */

.team {
    padding: 2rem 0;
}

.vision {
    background-color: #222;
    color: white;
    padding: 2rem;
    margin-bottom: 2rem;
}

.vision h2 {
    color: white;
}

.team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
}

.team-member {
    background-color: #ffe6ac;
}

.team-member img {
    width: 100%;
}

.team-member-content {
    padding: 1.2rem;
}

.team-member h3 {
    font-size: 1.4rem;
}

.team-member .role {
    font-weight: 700;
    margin-bottom: 0.7rem;
}


/* ==============================
   CONTACT PAGE
   ============================== */

.contact {
    padding: 2rem 0;
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
}

.contact-form {
    width: 100%;
}

.contact-form label {
    display: block;
    margin-bottom: 0.3rem;
    font-weight: 600;
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    border: 1px solid #222;
    padding: 0.7rem;
    margin-bottom: 1rem;
    background-color: white;
}

.contact-form textarea {
    min-height: 150px;
    resize: vertical;
}

.contact-form button {
    background-color: #222;
    color: white;
    border: none;
    padding: 0.8rem 1.5rem;
    cursor: pointer;
}

.contact-form button:hover {
    background-color: #c78c06;
    color: #222;
}


/* ==============================
   LOCATION / MAP
   ============================== */

.location img {
    width: 100%;
}

.location h2 {
    margin-bottom: 1rem;
}


/* ==============================
   HOURS OF OPERATION
   ============================== */

.hours {
    margin-top: 2rem;
}

.hours table {
    width: 100%;
    border-collapse: collapse;
}

.hours th {
    background-color: #ffe6ac;
    text-align: left;
    padding: 0.7rem;
}

.hours td {
    border: 1px solid #222;
    padding: 0.7rem;
}

.hours tr:nth-child(even) {
    background-color: #f7f7f7;
}


/* ==============================
   FOOTER
   ============================== */

footer {
    background-color: #222;
    color: white;
    padding: 2rem 0;
    margin-top: 2rem;
}

footer .container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

footer a {
    color: #ffe6ac;
}


/* ==============================
   TABLET / DESKTOP
   Minimum width: 760px
   ============================== */

@media screen and (min-width: 760px) {

    /* Navigation becomes horizontal */
    nav {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    nav ul {
        flex-direction: row;
        width: auto;
    }

    nav li {
        border-bottom: none;
    }

    nav a {
        padding: 0.7rem 1rem;
    }


    /* Hero layout */
    .hero .container {
        position: relative;
    }

    .hero-image {
        width: 100%;
    }

    .hero-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 70%;
    }

    .hero-content h1 {
        font-size: 3.5rem;
    }


    /* About uses Flexbox */
    .about .container {
        flex-direction: row;
        align-items: center;
    }

    .about-image,
    .about-content {
        width: 50%;
    }


    /* Services use CSS Grid */
    .featured-services {
        grid-template-columns: repeat(2, 1fr);
    }

    .services-grid {
        grid-template-columns: repeat(3, 1fr);
    }


    /* Team uses CSS Grid */
    .team-grid {
        grid-template-columns: repeat(2, 1fr);
    }


    /* Contact uses CSS Grid */
    .contact-grid {
        grid-template-columns: 1fr 1fr;
        align-items: start;
    }


    /* Footer uses Flexbox */
    footer .container {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }
}


/* ==============================
   LARGE DESKTOP
   ============================== */

@media screen and (min-width: 1000px) {

    .hero-content {
        width: 60%;
        padding: 2rem;
    }

    .hero-content h1 {
        font-size: 4rem;
    }

    h2 {
        font-size: 2.2rem;
    }

    .about {
        padding: 3rem 0;
    }

    .services,
    .team,
    .contact {
        padding: 3rem 0;
    }
}  