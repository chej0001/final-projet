/* =========================================
   CSS RESET
   ========================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Open Sans", sans-serif;
    color: #222;
    background-color: white;
    line-height: 1.6;
}

img {
    display: block;
    width: 100%;
}

a {
    text-decoration: none;
    color: inherit;
}

ul {
    list-style: none;
}


/* =========================================
   GENERAL CONTAINER
   ========================================= */

.container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
}


/* =========================================
   HEADER
   ========================================= */

header {
    background-color: #222;
    color: white;
}

nav {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.logo {
    display: block;
    background-color: #c78c06;
    color: #222;
    font-size: 1.5rem;
    font-weight: 700;
    padding: 0.8rem 1rem;
    width: 100%;
    text-align: center;
}

.navigation {
    width: 100%;
    display: flex;
    flex-direction: column;
}

.navigation li {
    width: 100%;
    text-align: center;
}

.navigation a {
    display: block;
    padding: 0.8rem;
    color: white;
}

.navigation a:hover,
.navigation a.active {
    background-color: #c78c06;
    color: #222;
}


/* =========================================
   HEADINGS
   ========================================= */

h1,
h2,
h3 {
    line-height: 1.2;
}

h1 {
    font-size: 2.2rem;
}

h2 {
    font-size: 1.9rem;
    margin-bottom: 1rem;
}

h3 {
    font-size: 1.3rem;
    margin-bottom: 0.7rem;
}


/* =========================================
   BUTTONS
   ========================================= */

.button {
    display: inline-block;
    background-color: #c78c06;
    color: #222;
    padding: 0.8rem 1.2rem;
    margin-top: 1rem;
    font-weight: 700;
}

.button:hover {
    background-color: #ffe6ac;
}


/* =========================================
   HERO
   ========================================= */

.hero {
    background-color: #222;
    color: white;
    padding: 2rem 0;
}

.hero-container {
    display: flex;
    flex-direction: column;
}

.hero-container img {
    width: 100%;
}

.hero-text {
    background-color: #222;
    padding: 1.5rem 0;
}

.hero-text h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.hero-text p {
    margin-bottom: 1rem;
}


/* =========================================
   ABOUT
   ========================================= */

.about {
    background-color: #ffe6ac;
    padding: 2rem 0;
}

.about-container {
    display: flex;
    flex-direction: column;
}

.about-container img {
    width: 100%;
}

.about-text {
    padding-top: 1.5rem;
}

.about-text p {
    margin-bottom: 1rem;
}


/* =========================================
   SERVICES
   ========================================= */

.services {
    padding: 2rem 0;
}

.services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
}

.service-card {
    background-color: #ffe6ac;
}

.service-card img {
    width: 100%;
}

.service-content {
    padding: 1.2rem;
}

.service-content p {
    margin-bottom: 0.5rem;
}


/* =========================================
   TEAM
   ========================================= */

.team {
    padding: 2rem 0;
}

.vision {
    background-color: #222;
    color: white;
    padding: 2rem;
    margin-bottom: 2rem;
}

.team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
}

.team-member {
    background-color: #ffe6ac;
}

.team-member img {
    width: 100%;
}

.team-member-content {
    padding: 1.2rem;
}

.role {
    font-weight: 700;
    margin-bottom: 0.7rem;
}


/* =========================================
   CONTACT
   ========================================= */

.contact {
    padding: 2rem 0;
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
}

.contact-form label {
    display: block;
    margin-bottom: 0.3rem;
    font-weight: 600;
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    padding: 0.7rem;
    border: 1px solid #222;
    margin-bottom: 1rem;
}

.contact-form textarea {
    min-height: 150px;
    resize: vertical;
}

.contact-form button {
    border: none;
    background-color: #222;
    color: white;
    padding: 0.8rem 1.5rem;
    cursor: pointer;
}

.contact-form button:hover {
    background-color: #c78c06;
    color: #222;
}


/* =========================================
   LOCATION
   ========================================= */

.location img {
    width: 100%;
}


/* =========================================
   HOURS
   ========================================= */

.hours {
    margin-top: 2rem;
}

.hours table {
    width: 100%;
    border-collapse: collapse;
}

.hours th {
    background-color: #ffe6ac;
    padding: 0.7rem;
    text-align: left;
}

.hours td {
    border: 1px solid #222;
    padding: 0.7rem;
}


/* =========================================
   FOOTER
   ========================================= */

footer {
    background-color: #222;
    color: white;
    padding: 2rem 0;
    margin-top: 2rem;
}

footer .container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

footer a {
    color: #ffe6ac;
}


/* =========================================
   DESKTOP
   Minimum width: 760px
   ========================================= */

@media screen and (min-width: 760px) {

    /* Navigation */
    nav {
        flex-direction: row;
        justify-content: space-between;
    }

    .logo {
        width: auto;
    }

    .navigation {
        width: auto;
        flex-direction: row;
    }

    .navigation li {
        width: auto;
    }

    .navigation a {
        padding: 1rem;
    }


    /* Hero */
    .hero {
        padding: 0;
    }

    .hero-container {
        position: relative;
        display: block;
    }

    .hero-container img {
        min-height: 500px;
        object-fit: cover;
    }

    .hero-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 75%;
        padding: 2rem;
        background-color: rgba(34, 34, 34, 0.9);
    }

    .hero-text h1 {
        font-size: 3.5rem;
    }


    /* About - Flexbox */
    .about-container {
        flex-direction: row;
        align-items: center;
        gap: 2rem;
    }

    .about-container img,
    .about-text {
        width: 50%;
    }

    .about-text {
        padding-top: 0;
    }


    /* Services - CSS Grid */
    .services-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .service-card:first-child {
        grid-column: span 1;
    }


    /* Team - CSS Grid */
    .team-grid {
        grid-template-columns: repeat(2, 1fr);
    }


    /* Contact - CSS Grid */
    .contact-grid {
        grid-template-columns: 1fr 1fr;
    }


    /* Footer - Flexbox */
    footer .container {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }
}


/* =========================================
   LARGE DESKTOP
   ========================================= */

@media screen and (min-width: 1000px) {

    h1 {
        font-size: 4rem;
    }

    h2 {
        font-size: 2.3rem;
    }

    .hero-text {
        width: 70%;
    }

    .hero-text h1 {
        font-size: 4rem;
    }

    .about,
    .services,
    .team,
    .contact {
        padding: 3rem 0;
    }
}