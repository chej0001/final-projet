/* ================================
   CSS RESET
================================ */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: "Open Sans", sans-serif;
    color: #222;
    background-color: white;
    line-height: 1.5;
}

img {
    display: block;
    width: 100%;
}

a {
    color: inherit;
}

h1,
h2,
h3,
p {
    margin-top: 0;
}


/* ================================
   GENERAL STYLES
================================ */

.container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
}

section {
    padding: 2rem 0;
}

h1 {
    font-size: 2rem;
    line-height: 1.2;
}

h2 {
    font-size: 1.8rem;
    margin-bottom: 1.5rem;
}

h3 {
    font-size: 1.3rem;
}


/* ================================
   HEADER
================================ */

.site-header {
    background-color: #c78c06;
}

.header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0;
}

.logo img {
    width: 100px;
    margin-bottom: 1rem;
}

.navigation {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
}

.navigation li {
    margin-bottom: 0.7rem;
}

.navigation a {
    text-decoration: none;
    color: #222;
    font-weight: 700;
}

.navigation a:hover {
    color: white;
}

.search-form {
    display: flex;
    width: 100%;
    margin-top: 0.5rem;
}

.search-form label {
    position: absolute;
    left: -9999px;
}

.search-form input {
    width: 100%;
    padding: 0.6rem;
    border: 1px solid #222;
}

.search-form button {
    padding: 0.6rem 0.8rem;
    border: 1px solid #222;
    background-color: white;
    cursor: pointer;
}


/* ================================
   HERO
================================ */

.hero {
    min-height: 500px;
    display: flex;
    align-items: center;

    background-image:
        linear-gradient(
            rgba(34, 34, 34, 0.55),
            rgba(34, 34, 34, 0.55)
        ),
        url("../images/main-banner.jpg");

    background-size: cover;
    background-position: center;
}

.hero-content {
    display: flex;
    align-items: center;
}

.hero-text {
    width: 100%;
    padding: 2rem 1.5rem;
    background-color: rgba(34, 34, 34, 0.85);
    color: white;
}

.hero-text h1 {
    margin-bottom: 1rem;
}

.button {
    display: inline-block;
    padding: 0.9rem 1.2rem;
    background-color: #c78c06;
    color: #222;
    text-decoration: none;
    border: 0;
    font-weight: 700;
    cursor: pointer;
}

.button:hover {
    background-color: #ffe6ac;
}

.button span {
    margin-left: 0.5rem;
}


/* ================================
   ABOUT US
================================ */

.about {
    background-color: white;
}

.about-grid {
    display: grid;
    gap: 1.5rem;
}

.about-image img {
    width: 100%;
}

.about-text h2 {
    margin-bottom: 1rem;
}


/* ================================
   SERVICES
================================ */

.services {
    background-color: #ffe6ac;
}

.service-grid {
    display: grid;
    gap: 1.5rem;
}

.service-card {
    background-color: white;
}

.service-content {
    padding: 1.2rem;
}

.service-content h3 {
    margin-bottom: 0.8rem;
}

.dark-button {
    display: block;
    padding: 1rem;
    background-color: #222;
    color: white;
    text-decoration: none;
    text-align: center;
    font-weight: 700;
}

.dark-button:hover {
    background-color: #c78c06;
    color: #222;
}

.dark-button span {
    margin-left: 0.5rem;
}


/* ================================
   OUR TEAM
================================ */

.team {
    background-color: white;
}

.team-grid {
    display: grid;
    gap: 1.5rem;
}

.team-member {
    background-color: #ffe6ac;
}

.team-member img {
    width: 100%;
}

.team-member div {
    padding: 1.2rem;
}

.team-member h3 {
    margin-bottom: 0.2rem;
}

.team-member strong {
    display: block;
    margin-bottom: 0.8rem;
}


/* ================================
   CONTACT
================================ */

.contact {
    background-color: #ffe6ac;
}

.contact-grid {
    display: grid;
    gap: 1.5rem;
}

.contact-form,
.location {
    background-color: white;
    padding: 1.2rem;
}

.contact-form form {
    display: flex;
    flex-direction: column;
}

.contact-form label {
    margin-bottom: 0.3rem;
    font-weight: 600;
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    padding: 0.7rem;
    margin-bottom: 1rem;
    border: 1px solid #222;
    font-family: "Open Sans", sans-serif;
}

.contact-form textarea {
    min-height: 150px;
    resize: vertical;
}

.contact-form .button {
    align-self: flex-start;
}

.location table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
}

.location th,
.location td {
    padding: 0.6rem;
    border: 1px solid #222;
    text-align: left;
}

.location th {
    background-color: #c78c06;
}

.map {
    min-height: 250px;
    background-color: #ddd;
    display: flex;
    align-items: center;
    justify-content: center;
}


/* ================================
   FOOTER
================================ */

footer {
    padding: 2rem 0;
    background-color: #222;
    color: white;
}

.footer-content {
    text-align: center;
}

.footer-content a {
    color: #ffe6ac;
}


/* ================================
   TABLET / DESKTOP
   760PX AND ABOVE
================================ */

@media screen and (min-width: 760px) {

    section {
        padding: 4rem 0;
    }

    h1 {
        font-size: 3rem;
    }

    h2 {
        font-size: 2.2rem;
    }

    /* Header becomes horizontal */
    .header-content {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .logo img {
        width: 100px;
        margin-bottom: 0;
    }

    .navigation {
        display: flex;
        gap: 1.5rem;
    }

    .navigation li {
        margin-bottom: 0;
    }

    .search-form {
        width: auto;
        margin-top: 0;
    }

    .search-form input {
        width: 150px;
    }

    /* About section uses CSS Grid */
    .about-grid {
        grid-template-columns: 1fr 1fr;
        align-items: center;
    }

    /* Services use CSS Grid */
    .service-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    /* Team uses CSS Grid */
    .team-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .team-member {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    /* Contact uses CSS Grid */
    .contact-grid {
        grid-template-columns: 1fr 1fr;
    }

    /* Footer uses Flexbox */
    .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
}


/* ================================
   LARGE DESKTOP
================================ */

@media screen and (min-width: 1000px) {

    .hero {
        min-height: 600px;
    }

    .hero-text {
        max-width: 700px;
        padding: 3rem;
    }

    .service-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}