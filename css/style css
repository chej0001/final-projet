/* =========================================
   CSS RESET
   ========================================= */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body,
h1,
h2,
h3,
h4,
p,
ul,
ol,
figure {
    margin: 0;
}

ul,
ol {
    padding: 0;
    list-style: none;
}

img {
    display: block;
    max-width: 100%;
}

button,
input,
textarea {
    font: inherit;
}

a {
    color: inherit;
    text-decoration: none;
}


/* =========================================
   GENERAL STYLES
   ========================================= */

body {
    font-family: "Open Sans", sans-serif;
    color: #222;
    background-color: white;
    line-height: 1.6;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
}

h1,
h2,
h3,
h4 {
    line-height: 1.2;
}

h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
}

p {
    margin-bottom: 1rem;
}


/* =========================================
   HEADER
   ========================================= */

.site-header {
    background-color: #222;
    color: white;
}

.header-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0;
}

.logo {
    display: block;
    margin-bottom: 1rem;
}

.logo img {
    width: 70px;
    height: auto;
}

.main-nav {
    width: 100%;
}

.main-nav ul {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.main-nav a {
    display: block;
    padding: 0.7rem 1rem;
    color: white;
    font-weight: 600;
}

.main-nav a:hover,
.main-nav .active {
    background-color: #c78c06;
    color: #222;
}

.search-form {
    display: flex;
    width: 100%;
    max-width: 350px;
    margin-top: 1rem;
}

.search-form label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
}

.search-form input {
    width: 100%;
    min-height: 42px;
    border: 0;
    padding: 0.5rem;
}

.search-form button {
    width: 45px;
    border: 0;
    background-color: #c78c06;
    color: #222;
    cursor: pointer;
    font-size: 1.3rem;
}


/* =========================================
   HERO
   ========================================= */

.hero {
    background-color: #222;
    padding: 0;
}

.hero-container {
    position: relative;
    width: 100%;
    max-width: 1200px;
}

.hero-image {
    width: 100%;
    min-height: 450px;
    object-fit: cover;
}

.hero-overlay {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    padding: 1.5rem;
    background-color: rgba(34, 34, 34, 0.85);
    color: white;
}

.hero-overlay h1 {
    font-size: 2.3rem;
    margin-bottom: 1rem;
}

.hero-overlay p {
    font-size: 0.95rem;
}

.button,
.service-button,
.vision-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.2rem;
    background-color: #c78c06;
    color: #222;
    font-weight: 700;
    transition: 0.2s ease;
}

.button:hover,
.service-button:hover,
.vision-button:hover {
    background-color: #ffe6ac;
}


/* =========================================
   ABOUT
   ========================================= */

.about {
    background-color: #ffe6ac;
    padding: 3rem 0;
}

.about-grid {
    display: grid;
    gap: 2rem;
}

.about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.about-content h2 {
    color: #222;
}


/* =========================================
   SERVICES
   ========================================= */

.services {
    padding: 3rem 0;
    background-color: white;
}

.services h2 {
    margin-bottom: 2rem;
}

.featured-services {
    display: grid;
    gap: 1.5rem;
}

.featured-service {
    background-color: #ffe6ac;
}

.featured-service img {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

.service-content {
    padding: 1.5rem;
}

.service-content h3,
.service-card-content h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
}

.service-button {
    width: 100%;
    background-color: #222;
    color: white;
}

.service-button:hover {
    background-color: #c78c06;
    color: #222;
}

.service-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
}

.service-card {
    background-color: #ffe6ac;
}

.service-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

.service-card-content {
    padding: 1.5rem;
}


/* =========================================
   TEAM
   ========================================= */

.team {
    padding: 3rem 0;
    background-color: #ffe6ac;
}

.team-grid {
    display: grid;
    gap: 1.5rem;
}

.team-member {
    background-color: white;
}

.team-member img {
    width: 100%;
    height: 300px;
    object-fit: cover;
}

.team-info {
    padding: 1.5rem;
}

.team-info h3 {
    font-size: 1.5rem;
    margin-bottom: 0.2rem;
}

.team-info h4 {
    margin-bottom: 1rem;
    font-weight: 600;
}


/* =========================================
   VISION
   ========================================= */

.vision {
    background-color: #222;
    color: white;
    padding: 3rem 0;
}

.vision-container {
    position: relative;
}

.vision-container img {
    width: 100%;
    min-height: 300px;
    object-fit: cover;
}

.vision-content {
    position: absolute;
    top: 50%;
    left: 5%;
    right: 5%;
    transform: translateY(-50%);
    background-color: rgba(34, 34, 34, 0.82);
    padding: 1.5rem;
}

.vision-content h2 {
    margin-bottom: 1rem;
}

.vision-button {
    background-color: #222;
    border: 1px solid #c78c06;
    color: white;
}


/* =========================================
   CONTACT
   ========================================= */

.contact {
    padding: 3rem 0;
    background-color: white;
}

.contact-grid {
    display: grid;
    gap: 2rem;
}

.contact-form h3,
.location h3,
.hours h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
}

.form-group {
    margin-bottom: 1rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.3rem;
}

.form-group input,
.form-group textarea {
    width: 100%;
    border: 1px solid #222;
    padding: 0.7rem;
}

.form-group textarea {
    resize: vertical;
}

.submit-button {
    padding: 0.8rem 1.5rem;
    background-color: #c78c06;
    border: 0;
    color: #222;
    font-weight: 700;
    cursor: pointer;
}

.submit-button:hover {
    background-color: #ffe6ac;
}

.map {
    width: 100%;
    height: 300px;
}

.map iframe {
    width: 100%;
    height: 100%;
    border: 0;
}

.hours {
    margin-top: 2.5rem;
}

.hours table {
    width: 100%;
    border-collapse: collapse;
}

.hours th,
.hours td {
    border: 1px solid #222;
    padding: 0.8rem;
    text-align: left;
}

.hours th {
    background-color: #ffe6ac;
}


/* =========================================
   FOOTER
   ========================================= */

.site-footer {
    background-color: #222;
    color: white;
    padding: 2rem 0;
}

.footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.footer-inner p {
    margin-bottom: 0.3rem;
}

.footer-inner a {
    color: #c78c06;
}

.footer-inner a:hover {
    color: #ffe6ac;
}


/* =========================================
   DESKTOP / TABLET
   760px AND ABOVE
   ========================================= */

@media screen and (min-width: 760px) {

    /* Header */
    .header-inner {
        flex-direction: row;
        align-items: center;
        gap: 1.5rem;
    }

    .logo {
        margin-bottom: 0;
        flex-shrink: 0;
    }

    .main-nav {
        width: auto;
        flex: 1;
    }

    .main-nav ul {
        flex-direction: row;
        justify-content: center;
    }

    .main-nav a {
        padding: 0.7rem 0.8rem;
    }

    .search-form {
        width: 200px;
        margin-top: 0;
    }


    /* Hero */
    .hero-image {
        min-height: 550px;
    }

    .hero-overlay {
        left: 8%;
        right: 8%;
        padding: 2rem;
    }

    .hero-overlay h1 {
        font-size: 3.5rem;
    }

    .hero-overlay p {
        max-width: 700px;
    }


    /* About */
    .about-grid {
        grid-template-columns: 1fr 1fr;
        align-items: center;
    }


    /* Featured services */
    .featured-services {
        grid-template-columns: 1fr 1fr;
    }

    .featured-service img {
        height: 250px;
    }


    /* Three smaller services */
    .service-grid {
        grid-template-columns: repeat(3, 1fr);
    }


    /* Team */
    .team-grid {
        grid-template-columns: 1fr 1fr;
    }

    .team-member {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .team-member img {
        height: 100%;
        min-height: 280px;
    }

    .team-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }


    /* Vision */
    .vision-container img {
        min-height: 400px;
    }

    .vision-content {
        left: 8%;
        right: 8%;
        padding: 2rem;
    }


    /* Contact */
    .contact-grid {
        grid-template-columns: 1fr 1fr;
        align-items: start;
    }


    /* Footer */
    .footer-inner {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

}