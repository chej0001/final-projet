/* =========================
   GLOBAL
========================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: "Open Sans", sans-serif;
    color: #222;
    background: #fff;
    line-height: 1.6;
}

img {
    display: block;
    width: 100%;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin-inline: auto;
}

h1,
h2,
h3,
h4,
p {
    margin-top: 0;
}


/* =========================
   HEADER
========================= */

header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #111;
    color: #fff;
}

.header-container {
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo-link {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 700;
}

.logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
}

nav ul {
    display: flex;
    align-items: center;
    gap: 30px;
    margin: 0;
    padding: 0;
    list-style: none;
}

nav a {
    display: block;
    padding: 25px 0;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
}

nav a:hover {
    color: #ffb400;
}


/* =========================
   BUTTON
========================= */

.button {
    display: inline-block;
    padding: 12px 20px;
    background: #e59a00;
    color: #fff;
    border: 0;
    text-decoration: none;
    font-weight: 700;
    cursor: pointer;
}

.button:hover {
    background: #c98200;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 430px;
    display: flex;
    align-items: center;
    background-image:
        linear-gradient(rgba(0, 0, 0, .62), rgba(0, 0, 0, .62)),
        url("../images/main-banner.jpg");
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
}

.hero-content {
    padding: 70px 0;
    color: #fff;
}

.hero h1 {
    max-width: 600px;
    margin-bottom: 15px;
    font-size: 3.3rem;
    line-height: 1.15;
}

.hero p {
    max-width: 470px;
    margin-bottom: 25px;
    font-size: 1.05rem;
}


/* =========================
   ABOUT
========================= */

.about {
    padding: 50px 0;
    background: #ffe8ae;
}

.about-content {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 50px;
}

.about-content img {
    height: 260px;
    object-fit: cover;
}

.about-text h2 {
    margin-bottom: 20px;
    font-size: 2rem;
}


/* =========================
   SERVICES
========================= */

.services {
    padding: 50px 0;
}

.services > .container > h2 {
    margin-bottom: 25px;
    text-align: center;
    font-size: 2rem;
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 15px;
}

.service-card {
    overflow: hidden;
    background: #ffe8ae;
}

.service-card img {
    height: 145px;
    object-fit: cover;
}

.service-content {
    padding: 15px;
}

.service-card h3 {
    margin-bottom: 10px;
    font-size: 1.05rem;
}

.service-card p {
    min-height: 125px;
    margin-bottom: 0;
    font-size: .9rem;
}

.service-card .button {
    width: 100%;
    padding: 9px;
    text-align: center;
}


/* =========================
   PROJECTS
========================= */

.projects {
    padding: 50px 0;
    background: #222;
    color: #fff;
}

.project-content {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    align-items: center;
    gap: 45px;
}

.project-text h2 {
    margin-bottom: 15px;
    font-size: 2rem;
}

.project-text h3 {
    margin-bottom: 15px;
    color: #e59a00;
}

.project-text p {
    max-width: 450px;
}

.project-image img {
    border: 3px solid #fff;
}


/* =========================
   VISION
========================= */

.vision {
    min-height: 260px;
    padding: 55px 0;
    color: #fff;
    background-image:
        linear-gradient(rgba(0, 0, 0, .45), rgba(0, 0, 0, .45)),
        url("../images/vision.jpg");
    background-position: center;
    background-size: cover;
}

.vision-content {
    min-height: 150px;
    display: flex;
    align-items: center;
}

.vision-text {
    max-width: 900px;
}

.vision-text h2 {
    margin-bottom: 15px;
    font-size: 2rem;
}

.vision-text p {
    max-width: 850px;
    margin-bottom: 20px;
    font-size: .95rem;
}


/* =========================
   TEAM
========================= */

.team {
    padding: 45px 0;
    background: #fff;
}

.team > .container > h2 {
    margin-bottom: 20px;
    text-align: center;
    font-size: 2rem;
}

.team-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid #bbb;
}

.team-image {
    min-height: 220px;
}

.team-image img {
    height: 100%;
    min-height: 220px;
    object-fit: cover;
}

.team-info {
    min-height: 220px;
    padding: 20px;
    background: #ffe8ae;
}

.team-info h3 {
    margin-bottom: 2px;
    font-size: 1.4rem;
}

.team-info h4 {
    margin-bottom: 10px;
    color: #d99300;
}

.team-info p {
    margin-bottom: 0;
    font-size: .9rem;
}


/* =========================
   CONTACT
========================= */

.contact {
    padding: 20px 0 50px;
}

.contact > .container > h2 {
    margin-bottom: 20px;
    font-size: 2rem;
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 40px;
}

.contact-form h3,
.location h3,
.hours h3 {
    font-size: 1.3rem;
}

.contact-form form {
    display: flex;
    flex-direction: column;
}

.contact-form label {
    margin-bottom: 3px;
    font-size: .85rem;
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    margin-bottom: 10px;
    padding: 10px;
    border: 1px solid #aaa;
    font-family: inherit;
}

.contact-form textarea {
    height: 120px;
    resize: vertical;
}

.contact-form .button {
    width: 100%;
}

.location iframe {
    width: 100%;
    height: 300px;
    border: 0;
}


/* =========================
   HOURS
========================= */

.hours {
    margin-top: 25px;
}

.hours table {
    width: 100%;
    border-collapse: collapse;
}

.hours th,
.hours td {
    padding: 10px;
    border: 1px solid #bbb;
}

.hours th {
    background: #ffe8ae;
}

.hours td {
    text-align: center;
}


/* =========================
   FOOTER
========================= */

footer {
    padding: 25px 0;
    background: #222;
    color: #fff;
}

.footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.footer-content p {
    margin: 0;
}

.footer-content a {
    color: #e59a00;
    text-decoration: none;
}


/* =========================
   TABLET
========================= */

@media (max-width: 900px) {

    .header-container {
        flex-direction: column;
        padding: 15px 0;
    }

    nav ul {
        justify-content: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    nav a {
        padding: 5px;
    }

    .service-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .about-content,
    .project-content,
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .team-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}


/* =========================
   PHONE
========================= */

@media (max-width: 600px) {

    .hero h1 {
        font-size: 2.3rem;
    }

    .service-grid,
    .team-grid {
        grid-template-columns: 1fr;
    }

    .team-image img {
        height: 250px;
    }

    .footer-content {
        flex-direction: column;
        gap: 10px;
        text-align: center;
    }

    nav ul {
        gap: 8px;
    }
}